{
  "name": "sams-rest-v2",
  "version": "0.1.0",
  "description": "Generated fetch SDK, types, and Zod schemas for the SAMS REST API v2.",
  "author": {
    "name": "Björn Kohnen",
    "email": "bjoern@vcmuellheim.de"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terijaki/sams-rest-v2.git"
  },
  "bugs": {
    "url": "https://github.com/terijaki/sams-rest-v2/issues"
  },
  "homepage": "https://github.com/terijaki/sams-rest-v2#readme",
  "keywords": [
    "SAMS",
    "volleyball",
    "openapi",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsup",
    "generate": "tsx scripts/generate-client.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bugs": "tsx scripts/check-sams-bugs.ts",
    "swagger:drift": "tsx scripts/check-sams-swagger-drift.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "typescript": ">=5.5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
